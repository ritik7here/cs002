# KindredBridge Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="KindredBridge API"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-chars

# PostgreSQL Database (Direct connection if needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
